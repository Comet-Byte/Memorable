#######################################################################
# PROJECT CONFIGURATION
#######################################################################

# Base URL of your application.
# Development:
#   http://localhost:3000
#
# Production:
#   https://yourdomain.com
#
# Used for:
# - Generating absolute URLs
# - OAuth callback URLs
# - API communication
NEXT_PUBLIC_BASE_URL="http://localhost:3000"


#######################################################################
# POSTHOG ANALYTICS
# https://posthog.com
#######################################################################

# PostHog is an open-source product analytics platform.
#
# Features:
# - User analytics
# - Event tracking
# - Feature flags
# - Session recordings
# - Funnels
#
# Onboarding:
# 1. Create a PostHog account.
# 2. Create a new project.
# 3. Copy the Project API Key.
# 4. Copy the API Host.
#
# Example:
# NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""


#######################################################################
# BETTER AUTH
# https://www.better-auth.com
#######################################################################

# Better Auth handles:
# - Login
# - Registration
# - Sessions
# - Password reset
# - Social login
# - User authentication
#
# BETTER_AUTH_URL
# Must match your application's public URL.
#
# Examples:
# Development:
#   http://localhost:3000
#
# Production:
#   https://app.company.com

BETTER_AUTH_URL="http://localhost:3000"

# Secret used for:
# - Session encryption
# - JWT signing
# - Cookie security
#
# IMPORTANT:
# Generate a strong random string.
#
# Example:
# openssl rand -base64 32

BETTER_AUTH_SECRET=""


#######################################################################
# DATABASE (POSTGRESQL)
#######################################################################

# PostgreSQL connection string used by Drizzle ORM.
#
# Supported providers:
# - Neon
# - Supabase
# - Railway
# - AWS RDS
# - DigitalOcean
# - Local PostgreSQL
#
# Example:
# postgres://username:password@host:5432/database
#
# Required for:
# - User data
# - Application data
# - Authentication
# - Migrations

DATABASE_URL=""


#######################################################################
# GOOGLE OAUTH PROVIDER
# https://console.cloud.google.com
#######################################################################

# Enables:
# - Sign in with Google
#
# Onboarding:
#
# 1. Open Google Cloud Console.
# 2. Create a Project.
# 3. Configure OAuth Consent Screen.
# 4. Create OAuth Client ID.
# 5. Add Authorized Redirect URI.
# 6. Copy Client ID and Client Secret.
#
# Redirect URI Example:
# http://localhost:3000/api/auth/callback/google
#
# Production Example:
# https://yourdomain.com/api/auth/callback/google

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


#######################################################################
# TRPC
#######################################################################

# Base URL for tRPC API.
#
# Development:
# http://localhost:3000/api/trpc
#
# Production:
# https://yourdomain.com/api/trpc
#
# Used for:
# - Type-safe API communication
# - Client ↔ Server requests

NEXT_PUBLIC_TRPC_BASE_URL="http://localhost:3000/api/trpc"


#######################################################################
# BUILD CONFIGURATION
#######################################################################

# Enables Bundle Analyzer.
#
# false = Disabled
# true  = Generate bundle size report
#
# Useful for:
# - Performance optimization
# - Detecting large dependencies

CONFIG_BUILD_ANALYZE="false"


#######################################################################
# CLOUDFLARE R2 OBJECT STORAGE
# https://developers.cloudflare.com/r2
#######################################################################

# Cloudflare R2 is S3-compatible object storage.
#
# Common Uses:
# - Image uploads
# - PDFs
# - Videos
# - Documents
# - User avatars
# - Backups
#
# Onboarding:
#
# 1. Create a Cloudflare account.
# 2. Open R2.
# 3. Create a Bucket.
# 4. Generate API Token.
# 5. Copy Access Key.
# 6. Copy Secret Key.
# 7. Copy Endpoint.
# 8. (Optional) Configure Public Domain.

# Bucket Name
CF_R2_BUCKET_NAME=""

# Public domain for serving uploaded files.
#
# Example:
# https://cdn.company.com

CF_R2_PUBLIC_DOMAIN=""

# API Endpoint
#
# Example:
# https://xxxxxxxx.r2.cloudflarestorage.com

CF_R2_ENDPOINT=""

# Access Key ID

CF_R2_ACCESS_KEY_ID=""

# Secret Access Key

CF_R2_SECRET_ACCESS_KEY=""


#######################################################################
# SENTRY ERROR MONITORING
# https://sentry.io
#######################################################################

# Sentry automatically monitors:
# - Server errors
# - Client errors
# - Stack traces
# - Performance
# - User sessions
#
# Onboarding:
#
# 1. Create Sentry project.
# 2. Choose Next.js.
# 3. Copy DSN.
# 4. Create Auth Token.
#
# The Auth Token is mainly used during deployment to upload source maps,
# allowing readable stack traces in Sentry.

SENTRY_AUTH_TOKEN=""

# Public DSN used by the frontend to send error reports.

NEXT_PUBLIC_SENTRY_DSN=""