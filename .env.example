#######################################################################
# BUILD CONFIGURATION
#######################################################################

# Enables Bundle Analyzer.
#
# false = Disabled
# true  = Generate bundle size report
#
# Useful for:
# - Performance optimization
# - Detecting large dependencies

CONFIG_BUILD_ANALYZE="false"


#######################################################################
# SUPABASE STORAGE (S3-COMPATIBLE OBJECT STORAGE)
# https://supabase.com/docs/guides/storage/s3/authentication
#######################################################################

# Supabase Storage is accessed here via its S3-compatible protocol,
# using the AWS S3 SDK (@aws-sdk/client-s3).
#
# Used for:
# - Invoice logo / signature image uploads (max 25 objects per user)
#
# Onboarding:
#
# 1. Create a Supabase project.
# 2. Storage -> create a Bucket. Mark it PUBLIC (required for image URLs to resolve).
# 3. Storage -> S3 Connection: copy the Endpoint and Region.
# 4. Storage -> S3 Access Keys: generate an Access Key ID + Secret Access Key.

# Bucket Name
SUPABASE_S3_BUCKET_NAME=""

# S3 protocol endpoint
# Example:
# https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=""

# Project region (shown next to the S3 connection details)
# Example: us-east-1
SUPABASE_S3_REGION=""

# Access Key ID
SUPABASE_S3_ACCESS_KEY_ID=""

# Secret Access Key
SUPABASE_S3_SECRET_ACCESS_KEY=""

# Public domain prefix used (server-side) to build the returned image URL.
# For a public Supabase bucket this is the object public path INCLUDING the bucket:
# Example:
# https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
SUPABASE_S3_PUBLIC_DOMAIN=""

# Same public prefix, exposed to the browser so next/image can render stored images.
# Set this to the SAME value as SUPABASE_S3_PUBLIC_DOMAIN.
NEXT_PUBLIC_STORAGE_PUBLIC_DOMAIN=""


#######################################################################
# SENTRY ERROR MONITORING
# https://sentry.io
#######################################################################

# Sentry automatically monitors:
# - Server errors
# - Client errors
# - Stack traces
# - Performance
# - User sessions
#
# Onboarding:
#
# 1. Create Sentry project.
# 2. Choose Next.js.
# 3. Copy DSN.
# 4. Create Auth Token.
#
# The Auth Token is mainly used during deployment to upload source maps,
# allowing readable stack traces in Sentry.

SENTRY_AUTH_TOKEN=""

# Public DSN used by the frontend to send error reports.

NEXT_PUBLIC_SENTRY_DSN=""