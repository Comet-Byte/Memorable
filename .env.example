#######################################################################
# PROJECT CONFIGURATION
#######################################################################

# Base URL of your application.
# Development:
#   http://localhost:3000
#
# Production:
#   https://yourdomain.com
#
# Used for:
# - Generating absolute URLs
# - OAuth callback URLs
# - API communication
NEXT_PUBLIC_BASE_URL="http://localhost:3000"


#######################################################################
# POSTHOG ANALYTICS
# https://posthog.com
#######################################################################

# PostHog is an open-source product analytics platform.
#
# Features:
# - User analytics
# - Event tracking
# - Feature flags
# - Session recordings
# - Funnels
#
# Onboarding:
# 1. Create a PostHog account.
# 2. Create a new project.
# 3. Copy the Project API Key.
# 4. Copy the API Host.
#
# Example:
# NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxxxxxxxxxxx"
# NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""


#######################################################################
# BETTER AUTH
# https://www.better-auth.com
#######################################################################

# Better Auth handles:
# - Login
# - Registration
# - Sessions
# - Password reset
# - Social login
# - User authentication
#
# BETTER_AUTH_URL
# Must match your application's public URL.
#
# Examples:
# Development:
#   http://localhost:3000
#
# Production:
#   https://app.company.com

BETTER_AUTH_URL="http://localhost:3000"

# Secret used for:
# - Session encryption
# - JWT signing
# - Cookie security
#
# IMPORTANT:
# Generate a strong random string.
#
# Example:
# openssl rand -base64 32

BETTER_AUTH_SECRET="hsqKz4NJFD8hqHmyFWugGkY4ua/dmeEwkvp0q4IC4OI="
BETTER_AUTH_API_KEY="ba_vpexps8md55c9d3w6svruz2zdzoqecm0"


